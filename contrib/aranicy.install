# A reinstall replaces the binary under a *running* process: systemd keeps the
# old inode alive, so the machine keeps running the previous build and applies
# nothing new until someone notices. Restart it (no-op if it is not running).
post_upgrade() {
    systemctl --quiet daemon-reload 2>/dev/null || true
    systemctl --quiet try-restart aranicy.service 2>/dev/null || true
}

# A daemon that outlives its package keeps applying priorities from deleted
# inodes, cannot be replaced by a reinstall (the new binary is a different
# file), and leaves an `enabled` symlink pointing at nothing. Stop it first.
pre_remove() {
    systemctl --quiet disable --now aranicy.service 2>/dev/null || true
}

# Cgroup directories are NOT package files: pacman cannot remove them, and the
# `cpu.max` the daemon wrote keeps throttling whatever still runs inside after
# the binary is gone (round-3 ivy-15). The daemon records the cgroups it
# created in /var/lib/aranicy/cgroups; move survivors back to the root cgroup,
# then remove the directories (a dir still holding a process cannot be rmdir'd,
# so the move is what releases the quota as well).
release_cgroups() (
    mount=${ANANICY_CGROUP_MOUNT:-/sys/fs/cgroup}
    record=${ANANICY_CGROUP_RECORD:-/var/lib/aranicy/cgroups}
    [ -r "$record" ] || return 0
    [ -w "$mount/cgroup.procs" ] || return 0
    left=0
    # The ledger can vanish between the `-r` test above and this redirect;
    # that is "nothing left to do", not an error to abort on (in
    # `install.sh --uninstall` an abort here would skip removing the binary).
    {
    while IFS= read -r name; do
        case "$name" in
            ''|.|..|*/*) continue ;;
        esac
        dir="$mount/$name"
        [ -d "$dir" ] || continue
        if [ -r "$dir/cgroup.procs" ]; then
            # The redirect can fail if the cgroup went away in between; that is
            # the directory-absent case below, not an error to abort on.
            {
                while IFS= read -r pid; do
                    [ -n "$pid" ] || continue
                    # A pid that exited between the read and the write is not a
                    # failure: the directory below is the arbiter.
                    echo "$pid" > "$mount/cgroup.procs" 2>/dev/null || true
                done < "$dir/cgroup.procs"
            } || true
        fi
        rmdir "$dir" 2>/dev/null || true
        if [ -d "$dir" ]; then
            left=1
        fi
    done < "$record"
    } || { [ ! -e "$record" ] || left=1; }
    # Keep the ledger when something is still pinned: a later run can retry,
    # and without the file those directories are unreachable forever.
    if [ "$left" = 0 ]; then
        rm -f "$record" 2>/dev/null || true
    else
        echo "aranicy: cgroup cleanup incomplete; kept $record - a cgroup may still be throttled" >&2 || true
    fi
    return 0
)

post_remove() {
    systemctl --quiet daemon-reload 2>/dev/null || true
    release_cgroups
    # The learned history is derived state, not configuration: leaving it
    # behind means a later reinstall resurrects biases for a machine that has
    # since changed (and the nice values they were applied to are gone).
    rm -f /var/lib/aranicy/bias-state 2>/dev/null || true
    rmdir /var/lib/aranicy 2>/dev/null || true
}
