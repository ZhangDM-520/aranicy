# A reinstall replaces the binary under a *running* process: systemd keeps the
# old inode alive, so the machine keeps running the previous build and applies
# nothing new until someone notices. Restart it (no-op if it is not running).
post_upgrade() {
    systemctl --quiet daemon-reload 2>/dev/null || true
    systemctl --quiet try-restart aranicy.service 2>/dev/null || true
}

# A daemon that outlives its package keeps applying priorities from deleted
# inodes, cannot be replaced by a reinstall (the new binary is a different
# file), and leaves an `enabled` symlink pointing at nothing. Stop it first.
pre_remove() {
    systemctl --quiet disable --now aranicy.service 2>/dev/null || true
}

post_remove() {
    systemctl --quiet daemon-reload 2>/dev/null || true
    # The learned history is derived state, not configuration: leaving it
    # behind means a later reinstall resurrects biases for a machine that has
    # since changed (and the nice values they were applied to are gone).
    rm -f /var/lib/aranicy/bias-state 2>/dev/null || true
    rmdir /var/lib/aranicy 2>/dev/null || true
}
