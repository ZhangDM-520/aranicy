[Unit]
Description=aranicy - auto-nice daemon
Documentation=https://github.com/ZhangDM-520/aranicy
After=local-fs.target aranicy-collector.service
Requires=aranicy-collector.service
Conflicts=ananicy-cpp.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
ExecStart=/usr/bin/aranicy start
ExecReload=/usr/bin/aranicy --reload
# Persistent bias history lives in /var/lib/aranicy (bias_state_path).
StateDirectory=aranicy
Nice=-5
OOMScoreAdjust=-999
Restart=always
RestartSec=10

# Hardening (kept from the ananicy-cpp unit shape; cgroups must stay writable)
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=no
PrivateUsers=no
# Lifecycle: systemd owns the collector; aranicy summons it via Requires=/
# After= above and waits (collector_wait_ms) for its sockets at startup.
# aranicy no longer loads BPF, so the BPF capabilities moved to
# aranicy-collector.service.
# CAP_SYS_PTRACE: the exec-name fallback reads /proc/<pid>/exe, which
# needs ptrace_may_access() for non-dumpable processes.
CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_RESOURCE CAP_DAC_OVERRIDE CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
